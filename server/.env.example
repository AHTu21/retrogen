# Скопируйте в server/.env и подставьте свои данные от локального PostgreSQL.
# Создайте базу, например: CREATE DATABASE retrogen;

# Типичная установка Windows/Linux: пользователь postgres, порт 5432
DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/retrogen"

# Если у вас другой пользователь и без пароля (только для доверенной среды):
# DATABASE_URL="postgresql://имя@localhost:5432/retrogen"

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Клиент (Vite) по умолчанию слушает 0.0.0.0:5173; API проксируется с браузера на этот сервер.
# Доступ извне: откройте порт 5173 в брандмауэре Windows, при NAT — проброс 5173 на ваш ПК.
# Пример URL: http://178.66.49.239:5173/ — см. также client/.env.example (VITE_DEV_PUBLIC_HOST для HMR).

# Дополнительные подстроки для отклонения темы (через запятую, без регистра). Пример: spam,slur1
# RETROGEN_THEME_DENIED_SUBSTRINGS=
