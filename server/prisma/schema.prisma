generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  user
  admin
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String     @default("")
  /** Cloud-synced profile subset (v1 JSON, без avatar/wallpaper data URL) */
  profileJson  Json?
  globalRole   GlobalRole @default(user)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedRooms       Room[]       @relation("RoomOwner")
  memberships      RoomMember[]
  chatMemberships  ChatMember[]
  createdChats     Chat[]       @relation("ChatCreator")
  messages         Message[]
  hiddenMessages   MessageHidden[]
}

/** Участник комнаты с ролью (расширяемо: co-facilitator, viewer). */
model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** facilitator | member | viewer */
  role      String
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model Room {
  id              String    @id @default(uuid())
  slug            String    @unique
  /** retro — полный набор колонок ретро; empty — только свободный холст (расширяемо). */
  kind            String    @default("retro")
  status          String    @default("live")
  themeRaw        String
  themeSanitized  String
  themePackJson   Json
  createdAt       DateTime  @default(now())
  endedAt         DateTime?
  /** Зум, смещение, раскладки блоков/стикеров, мемы — источник правды для синхронизации доски */
  planeStateJson  Json?
  planeVersion    Int       @default(0)
  /** Создатель комнаты (если null — «открытая» комната как раньше, сброс/завершение без проверки владельца). */
  ownerId         String?
  owner           User?     @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /** Показывать ли комнату в общем лобби (GET /api/rooms). */
  listedInLobby   Boolean   @default(true)
  /** Bcrypt-хэш пароля для входа в комнату (гости и не-участники); null — без пароля. */
  joinPasswordHash String?

  blocks            Block[]
  members           RoomMember[]
  cards             Card[]
  sprintStarEntries SprintStarEntry[]
  sprintStarVotes   SprintStarVote[]
  retroRatings      RetroRating[]
  retroOneThings    RetroOneThing[]
  warmupVotes       WarmupVote[]
  actionItems       ActionItem[]
  cardReactions     CardReaction[]
}

model ActionItem {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Block {
  id          String @id @default(uuid())
  roomId      String
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind        String
  sortOrder   Int
  gridColumns Int    @default(5)

  cards Card[]
}

model Card {
  id                String   @id @default(uuid())
  roomId            String
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  blockId           String
  block             Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  text              String   @default("")
  /** TipTap / ProseMirror JSON; канон при сохранении из редактора. HTML в `text` — кэш для просмотра и отчётов. */
  textDoc           Json?
  anonymous         Boolean  @default(false)
  authorDisplayName String?
  row               Int      @default(0)
  col               Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reactions         CardReaction[]
}

/** Реакция на стикер: один участник — не более одной записи на пару (emoji, карточка) */
model CardReaction {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  voterKey  String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([cardId, voterKey, emoji])
  @@index([roomId])
  @@index([cardId])
}

model SprintStarEntry {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String
  photoUrl  String?
  note      String?
  starCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     SprintStarVote[]
}

model SprintStarVote {
  id         String          @id @default(uuid())
  roomId     String
  room       Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  entryId    String
  entry      SprintStarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voterKey   String
  createdAt  DateTime        @default(now())

  @@unique([roomId, voterKey])
}

model RetroRating {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voterKey  String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, voterKey])
}

model RetroOneThing {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voterKey  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, voterKey])
}

model WarmupVote {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  optionId  String
  voterKey  String
  voterName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, voterKey])
}

enum ChatKind {
  direct
  group
  channel
  system
}

enum ChatMemberRole {
  owner
  admin
  member
}

enum MessageKind {
  text
  system
  file
}

enum ReceiptKind {
  delivered
  read
}

model Chat {
  id            String    @id @default(uuid())
  kind          ChatKind
  title         String    @default("")
  description   String    @default("")
  avatarUrl     String?
  systemKey     String?   @unique
  directKey     String?   @unique
  createdById   String?
  createdBy     User?     @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageId String?
  lastMessage   Message?  @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  members       ChatMember[]
  messages      Message[] @relation("ChatMessages")

  @@index([updatedAt])
}

model ChatMember {
  id                 String         @id @default(uuid())
  chatId             String
  chat               Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               ChatMemberRole @default(member)
  joinedAt           DateTime       @default(now())
  lastReadMessageId  String?
  mutedUntil         DateTime?

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id               String      @id @default(uuid())
  chatId           String
  chat             Chat        @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind             MessageKind @default(text)
  text             String      @default("")
  replyToMessageId String?
  replyTo          Message?    @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]   @relation("MessageReply")
  clientMessageId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  editedAt         DateTime?
  deletedAt        DateTime?
  attachments      MessageAttachment[]
  receipts         MessageReceipt[]
  hiddenFor        MessageHidden[]
  lastMessageFor   Chat[]      @relation("ChatLastMessage")

  @@unique([chatId, clientMessageId])
  @@index([chatId, createdAt])
  @@index([authorId])
}

model MessageAttachment {
  id           String   @id @default(uuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  createdAt    DateTime @default(now())

  @@index([messageId])
}

model MessageReceipt {
  id        String      @id @default(uuid())
  messageId String
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  kind      ReceiptKind
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, kind])
  @@index([userId])
}

/** Сообщение скрыто только у данного пользователя («удалить у меня»). */
model MessageHidden {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}
